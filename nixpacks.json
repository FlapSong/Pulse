{
  "providers": ["node"],
  "variables": {
    "ELECTRON_SKIP_BINARY_DOWNLOAD": "1"
  },
  "phases": {
    "setup": {
      "nixPkgs": ["nodejs_20"]
    },
    "install": {
      "cmd": "npm install --include=dev"
    },
    "build": {
      "cmd": "npm run build"
    }
  },
  "start": {
    "cmd": "npm start"
  }
}
