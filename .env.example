# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# 🚀 RESEND API KEY (Рекомендуемый способ отправки писем)
# Получите бесплатный API ключ на https://resend.com
RESEND_API_KEY="re_123456789..."

# Real Email SMTP Settings (For sending real verification codes to Mail.ru, Yandex, Gmail, etc.)
# For Mail.ru:
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_USER="your-email@mail.ru"
SMTP_PASS="your-app-password-from-mailru"
SMTP_FROM="Pulse HQ <your-email@mail.ru>"

# Alternative Yandex / Gmail settings:
# SMTP_HOST="smtp.yandex.ru"
# SMTP_USER="your-email@yandex.ru"
# SMTP_PASS="your-app-password-from-yandex"


